<Project Sdk="Microsoft.NET.Sdk">
  <!-- Contract client generated by Kiota from the locked OpenAPI (DAN-958); never edit Generated/ by hand:
       node scripts/contract-client.mjs generate. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Bundle's own dependencies are open ranges; packages.lock.json pins them (locked restore in CI). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime of the generated code (abstractions, HttpClient adapter, JSON). Stable release, at least two weeks old. -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.1.2" />
  </ItemGroup>
</Project>
